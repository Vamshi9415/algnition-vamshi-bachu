# pickle/model.pkl
pickle/model.pkl
ml_engine/pickle/model.pkl
*.pkl

# Output
output/
!output/.gitkeep
ml_engine/output/
!ml_engine/output/.gitkeep

# Reports (generated at runtime)
reports/
!reports/.gitkeep
ml_engine/reports/
!ml_engine/reports/.gitkeep

